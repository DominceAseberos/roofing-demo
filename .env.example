# Server-only. Used by src/server/whopService.ts through TanStack server functions.
# WHOP_API_KEY is reserved by the Whop hosted runtime, so use the namespaced name.
ROOFING_WHOP_API_KEY=

# A hidden Whop variant used as an invoice unit. The $14,000 demo invoices 14 x $1,000.
ROOFING_FINAL_INVOICE_VARIANT_ID=
ROOFING_FINAL_INVOICE_UNIT_AMOUNT=1000
